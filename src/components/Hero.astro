---
import { getContent } from '../lib/content';
const content = getContent();
const h = content.hero || {};
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image layer -->
  <div
    class="absolute inset-0 hero-background-layer"
    style="background-image: url('/images/hero-background.webp'); background-size: cover; background-position: center;"
    aria-hidden="true"
  ></div>

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-slate-900/65" aria-hidden="true"></div>

  <!-- Bubble pattern overlay -->
  <div class="absolute inset-0 bubble-pattern-hero opacity-60" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
    <div class="max-w-3xl mx-auto text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-slate-200 text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-6">
        <i class="fas fa-shield-check text-slate-300"></i>
        {h.badge}
      </div>

      <!-- Business name -->
      <p class="text-slate-300 font-semibold text-base sm:text-lg tracking-wide mb-3">
        {h.eyebrow}
      </p>

      <!-- Heading -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight mb-4">
        {h.headline1}<br />
        <span class="text-slate-300">{h.headline2}</span>
      </h1>

      <!-- Subheading -->
      <p class="text-lg sm:text-xl text-slate-200 leading-relaxed mb-8 max-w-2xl mx-auto">
        {h.subheadline}
      </p>

      <!-- Trust badges row -->
      <div class="flex flex-wrap justify-center gap-4 mb-10">
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-white text-sm font-medium">
          <i class="fas fa-star text-yellow-400 text-xs"></i>
          5-Star Rated
        </div>
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-white text-sm font-medium">
          <i class="fas fa-user-shield text-slate-300 text-xs"></i>
          Background-Checked
        </div>
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-white text-sm font-medium">
          <i class="fas fa-leaf text-green-400 text-xs"></i>
          Eco-Friendly
        </div>
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-white text-sm font-medium">
          <i class="fas fa-redo text-slate-300 text-xs"></i>
          Satisfaction Guaranteed
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 bg-[#0F172A] hover:bg-[#07101e] text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-black/40 transition-all duration-200 hover:scale-105"
        >
          <i class="fas fa-calendar-check"></i>
          {h.ctaPrimary}
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white font-semibold text-base px-8 py-4 rounded-xl transition-all duration-200"
        >
          <i class="fas fa-grid-2"></i>
          {h.ctaSecondary}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce-slow">
    <a href="#services" aria-label="Scroll down" class="flex flex-col items-center gap-2 text-white/60 hover:text-white/90 transition-colors">
      <i class="fas fa-chevron-down text-xl"></i>
    </a>
  </div>
</section>
