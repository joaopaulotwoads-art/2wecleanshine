<section id="location" class="py-20 md:py-28 bg-white bubble-pattern-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-[#0F172A] font-semibold text-sm uppercase tracking-widest mb-3">Our Service Area</p>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">We're Ready to Help You!</h2>
      <p class="text-slate-500 text-lg max-w-xl mx-auto">
        We cover multiple cities and neighborhoods across Georgia.
      </p>
      <div class="inline-flex items-center gap-2 mt-4 bg-[#0F172A]/5 border border-[#0F172A]/10 text-[#0F172A] text-sm font-medium px-4 py-2 rounded-full">
        <i class="fas fa-location-dot text-[#0F172A]"></i>
        Base location: Marietta, Georgia
      </div>
    </div>

    <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-100">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d212270.36643276856!2d-84.58411082697816!3d33.76763375741033!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88f5045d6993098d%3A0x66fede2f990b630b!2sAtlanta%2C%20GA!5e0!3m2!1sen!2sus!4v1715832132134!5m2!1sen!2sus"
        width="100%"
        height="480"
        style="border: 0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Clean & Shine Service Area - Marietta, Georgia"
      ></iframe>
    </div>
  </div>
</section>
