---
const faqs = [
  {
    q: 'What is included in Regular Cleaning?',
    a: 'Regular Cleaning covers kitchens, bathrooms, dusting, vacuuming, mopping, trash removal, and general room organization based on your service checklist.',
  },
  {
    q: 'Do you bring your own products and equipment?',
    a: 'Yes. Our team arrives with professional cleaning products and tools. If you prefer specific products for allergies or personal preference, let us know in advance.',
  },
  {
    q: 'How long does a cleaning appointment usually take?',
    a: 'It depends on home size, condition, and service type. Most regular cleanings take a few hours, while deep cleaning and move-in/move-out visits may take longer.',
  },
  {
    q: 'Do you offer recurring weekly or bi-weekly service?',
    a: 'Yes. We offer recurring plans (weekly, bi-weekly, and monthly) so your home or office stays consistently clean.',
  },
  {
    q: 'How can I request a quote?',
    a: 'Fill out the form on this page with your details and preferred service, or call/text us at 678 650 2983 for a faster estimate.',
  },
  {
    q: 'What areas do you serve?',
    a: 'We serve multiple cities and neighborhoods across Georgia. Send your ZIP code and we confirm availability for your location.',
  },
  {
    q: 'Is your team insured?',
    a: 'Yes. Clean & Shine is fully bonded and insured for your complete peace of mind. Every team member is also background-checked.',
  },
  {
    q: 'What if I am not satisfied with the cleaning?',
    a: "If you're not satisfied, we'll re-clean for free. Your satisfaction is our top priority on every visit.",
  },
];
---

<section id="faq" class="py-20 md:py-28 bg-white bubble-pattern-light">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-[#0F172A] font-semibold text-sm uppercase tracking-widest mb-3">Got Questions?</p>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
      <p class="text-slate-500 text-lg">
        Everything you need to know about our cleaning services.
      </p>
    </div>

    <div class="space-y-3" id="faq-list">
      {faqs.map((faq, i) => (
        <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none">
            <h3 class="font-semibold text-slate-900 text-base pr-4">{faq.q}</h3>
            <span class="shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-[#0F172A]/5 text-[#0F172A] group-open:bg-[#0F172A] group-open:text-white transition-colors">
              <i class="fas fa-chevron-down text-xs group-open:rotate-180 transition-transform duration-200"></i>
            </span>
          </summary>
          <div class="px-5 pb-5 pt-0">
            <p class="text-slate-600 leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="text-center mt-12">
      <p class="text-slate-500 mb-4">Still have questions? Reach out directly.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:+16786502983" class="inline-flex items-center justify-center gap-2 bg-[#0F172A] hover:bg-[#07101e] text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          <i class="fas fa-phone"></i>
          Call or Text: 678-650-2983
        </a>
        <a href="mailto:cleaneshine@hotmail.com" class="inline-flex items-center justify-center gap-2 border border-slate-200 hover:border-[#0F172A]/30 text-slate-700 hover:text-[#0F172A] font-semibold px-6 py-3 rounded-xl transition-colors">
          <i class="fas fa-envelope"></i>
          Email Us
        </a>
      </div>
    </div>
  </div>
</section>
