---
import { getContent } from '../lib/content';
const content = await getContent();
const a = content.about || {};
const trustBadges = a.trustBadges || [];
---

<section id="about" class="py-20 md:py-28 bg-slate-900 text-white bubble-pattern-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: text -->
      <div>
        <p class="text-slate-300 font-semibold text-sm uppercase tracking-widest mb-3">{a.eyebrow}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
          {a.headline1}<br />
          <span class="text-slate-300">{a.headline2}</span>
        </h2>
        <div class="space-y-4 text-slate-300 leading-relaxed">
          <p>{a.paragraph1}</p>
          <p>{a.paragraph2}</p>
          <p>{a.paragraph3}</p>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 mt-10">
          <div>
            <p class="text-4xl font-bold text-white">{a.stat1Value}</p>
            <p class="text-slate-400 text-sm mt-1">{a.stat1Label}</p>
          </div>
          <div>
            <p class="text-4xl font-bold text-white">{a.stat2Value}</p>
            <p class="text-slate-400 text-sm mt-1">{a.stat2Label}</p>
          </div>
          <div>
            <p class="text-4xl font-bold text-white">{a.stat3Value}</p>
            <p class="text-slate-400 text-sm mt-1">{a.stat3Label}</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 mt-8">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 bg-white text-[#0F172A] hover:bg-slate-100 font-semibold px-6 py-3 rounded-xl transition-colors"
          >
            <i class="fas fa-calendar-check"></i>
            {a.ctaLabel}
          </a>
          <a
            href={`tel:${a.phoneHref || '+16786502983'}`}
            class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-6 py-3 rounded-xl transition-colors"
          >
            <i class="fas fa-phone"></i>
            {content.contact?.phone || ''}
          </a>
        </div>
      </div>

      <!-- Right: image + trust badges -->
      <div class="flex flex-col gap-6">
        <!-- Photo -->
        <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-white/5 border border-white/10">
          <img
            src="/images/about.webp"
            alt="Clean & Shine team at work"
            class="w-full h-full object-cover"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
          />
          <!-- Placeholder until you add about.webp -->
          <div class="hidden absolute inset-0 flex-col items-center justify-center gap-3 text-slate-500">
            <i class="fas fa-image text-4xl"></i>
            <p class="text-sm">Adicione <code class="bg-white/10 px-1.5 py-0.5 rounded text-xs">public/images/about.webp</code></p>
          </div>
        </div>

        <!-- Trust badges -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {trustBadges.map(badge => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 hover:bg-white/10 transition-colors">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 text-slate-300">
                  <i class={`fas ${badge.icon}`}></i>
                </div>
                <h3 class="font-bold text-white">{badge.label}</h3>
              </div>
              <p class="text-slate-400 text-sm leading-relaxed">{badge.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
