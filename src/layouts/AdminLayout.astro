---
export interface Props { title: string; }
const { title } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { label: 'Dashboard', href: '/admin',          icon: 'fa-gauge-high',    group: 'main' },
  { label: 'Gallery',   href: '/admin/gallery',  icon: 'fa-images',        group: 'main' },
  { label: 'Content',   href: '/admin/content',  icon: 'fa-pen-to-square', group: 'main' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Admin</title>
  <link rel="icon" type="image/png" href="/images/Logo-fundo-tt.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'Inter', sans-serif; background: #020817; color: #e2e8f0; }
    body { display: flex; }

    /* ── Sidebar ── */
    #sidebar {
      width: 240px;
      min-width: 240px;
      height: 100vh;
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      background: #0a0f1e;
      border-right: 1px solid rgba(255,255,255,0.05);
      z-index: 40;
    }

    /* Brand */
    .sidebar-brand {
      padding: 1.25rem 1.25rem 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .brand-logo {
      display: flex; align-items: center; gap: 0.75rem;
    }
    .brand-icon {
      width: 36px; height: 36px; border-radius: 10px;
      background: linear-gradient(135deg, #1d4ed8, #3b82f6);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 12px rgba(59,130,246,0.3);
      flex-shrink: 0;
    }
    .brand-icon i { color: white; font-size: 0.85rem; }
    .brand-text { line-height: 1.2; }
    .brand-text strong { display: block; font-size: 0.875rem; font-weight: 700; color: #f1f5f9; }
    .brand-text span { font-size: 0.7rem; color: #475569; text-transform: uppercase; letter-spacing: 0.08em; }

    /* Nav */
    .sidebar-nav {
      flex: 1;
      padding: 0.875rem 0.75rem;
      overflow-y: auto;
    }
    .nav-section-label {
      font-size: 0.65rem;
      font-weight: 600;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0 0.625rem;
      margin: 1rem 0 0.375rem;
    }
    .nav-section-label:first-child { margin-top: 0; }

    .nav-link {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 500;
      color: #64748b;
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
      margin-bottom: 2px;
      position: relative;
    }
    .nav-link:hover { background: rgba(255,255,255,0.04); color: #cbd5e1; }
    .nav-link.active {
      background: rgba(59,130,246,0.12);
      color: #60a5fa;
    }
    .nav-link.active::before {
      content: '';
      position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      width: 3px; height: 60%; border-radius: 0 3px 3px 0;
      background: #3b82f6;
    }
    .nav-link i { width: 16px; text-align: center; font-size: 0.8rem; flex-shrink: 0; }
    .nav-link .ext-icon { margin-left: auto; font-size: 0.6rem; opacity: 0.35; }

    /* Sidebar footer */
    .sidebar-footer {
      padding: 0.75rem;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    .view-site-btn {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 500;
      color: #64748b;
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
      margin-bottom: 4px;
    }
    .view-site-btn:hover { background: rgba(255,255,255,0.04); color: #cbd5e1; }
    .view-site-btn i { width: 16px; text-align: center; font-size: 0.8rem; }

    .signout-btn {
      display: flex; align-items: center; gap: 0.75rem;
      width: 100%; padding: 0.6rem 0.75rem;
      border-radius: 8px;
      font-size: 0.82rem; font-weight: 500;
      font-family: 'Inter', sans-serif;
      color: #64748b;
      background: none; border: none; cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .signout-btn:hover { background: rgba(239,68,68,0.06); color: #f87171; }
    .signout-btn i { width: 16px; text-align: center; font-size: 0.8rem; }

    /* ── Main ── */
    #main-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      overflow: hidden;
    }

    /* Top bar */
    #topbar {
      height: 52px;
      min-height: 52px;
      background: rgba(10,15,30,0.8);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 30;
    }

    /* Mobile menu toggle */
    #menu-toggle {
      display: none;
      background: none; border: none;
      color: #64748b; font-size: 1.1rem; cursor: pointer;
      padding: 0.25rem;
    }

    .topbar-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: #f1f5f9;
    }
    .topbar-sep { color: #334155; font-size: 0.7rem; }
    .topbar-sub { font-size: 0.78rem; color: #64748b; font-weight: 400; }

    /* Page content */
    #page-content {
      flex: 1;
      overflow-y: auto;
      padding: 1.75rem;
      background:
        radial-gradient(ellipse 60% 40% at 70% -10%, rgba(59,130,246,0.05) 0%, transparent 60%),
        #020817;
    }

    /* Mobile overlay */
    #sidebar-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 39;
    }

    @media (max-width: 768px) {
      #sidebar {
        position: fixed; left: -240px; top: 0; bottom: 0;
        transition: left 0.25s ease;
      }
      #sidebar.open { left: 0; }
      #sidebar-overlay.open { display: block; }
      #menu-toggle { display: block; }
    }
  </style>
</head>
<body>

  <!-- Mobile overlay -->
  <div id="sidebar-overlay"></div>

  <!-- Sidebar -->
  <aside id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-logo">
        <div class="brand-icon"><i class="fas fa-broom"></i></div>
        <div class="brand-text">
          <strong>Clean &amp; Shine</strong>
          <span>Admin Panel</span>
        </div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="nav-section-label">Menu</p>

      {nav.map(item => {
        const active = item.href === '/admin' ? path === '/admin' : path.startsWith(item.href);
        return (
          <a href={item.href} class={`nav-link ${active ? 'active' : ''}`}>
            <i class={`fas ${item.icon}`}></i>
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="sidebar-footer">
      <a href="/" target="_blank" class="view-site-btn">
        <i class="fas fa-arrow-up-right-from-square"></i>
        View Site
        <i class="fas fa-arrow-up-right-from-square ext-icon" style="margin-left:auto"></i>
      </a>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="signout-btn">
          <i class="fas fa-right-from-bracket"></i>
          Sign Out
        </button>
      </form>
    </div>
  </aside>

  <!-- Main -->
  <div id="main-wrap">
    <header id="topbar">
      <button id="menu-toggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <span class="topbar-title">{title}</span>
    </header>

    <main id="page-content">
      <slot />
    </main>
  </div>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const toggle = document.getElementById('menu-toggle');

    function openSidebar() {
      sidebar?.classList.add('open');
      overlay?.classList.add('open');
    }
    function closeSidebar() {
      sidebar?.classList.remove('open');
      overlay?.classList.remove('open');
    }

    toggle?.addEventListener('click', openSidebar);
    overlay?.addEventListener('click', closeSidebar);
  </script>

</body>
</html>
