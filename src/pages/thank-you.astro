---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Request Sent — Clean & Shine Services">
  <div class="min-h-screen flex items-center justify-center px-4 bg-slate-50">
    <div class="text-center max-w-md">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Request Sent!</h1>
      <p class="text-slate-500 text-lg mb-8">
        Thank you for reaching out. We'll get back to you within 24 hours with your free estimate.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-[#0F172A] hover:bg-[#07101e] text-white font-semibold px-6 py-3 rounded-xl transition-colors"
      >
        ← Back to Home
      </a>
    </div>
  </div>
</Layout>
