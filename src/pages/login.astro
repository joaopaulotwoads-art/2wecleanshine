---
export const prerender = false;
import { isAuthenticated } from '../lib/auth';

if (isAuthenticated(Astro.request)) {
  return Astro.redirect('/admin');
}

const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') || '/admin';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Clean & Shine Admin</title>
  <link rel="icon" type="image/png" href="/images/Logo-fundo-tt.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'Inter', sans-serif; background: #020817; }

    .login-bg {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
    }

    /* Ambient glows */
    .glow-1 {
      position: fixed; top: -20%; left: -10%;
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 65%);
      pointer-events: none;
    }
    .glow-2 {
      position: fixed; bottom: -20%; right: -10%;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(99,102,241,0.1) 0%, transparent 65%);
      pointer-events: none;
    }

    /* Grid pattern */
    .grid-pattern {
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
    }

    .card {
      width: 100%;
      max-width: 420px;
      position: relative;
      z-index: 10;
    }

    /* Brand badge */
    .brand {
      text-align: center;
      margin-bottom: 2rem;
    }
    .brand-icon {
      width: 60px; height: 60px;
      background: linear-gradient(135deg, #1d4ed8, #3b82f6);
      border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1rem;
      box-shadow: 0 8px 24px rgba(59,130,246,0.35);
    }
    .brand-icon i { color: white; font-size: 1.5rem; }
    .brand h1 { color: #f1f5f9; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem; }
    .brand p { color: #64748b; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }

    /* Form card */
    .form-card {
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 0 25px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03) inset;
    }

    .form-title {
      color: #f1f5f9;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    /* Error */
    .error-box {
      display: flex; align-items: center; gap: 0.625rem;
      background: rgba(239,68,68,0.08);
      border: 1px solid rgba(239,68,68,0.25);
      color: #f87171;
      font-size: 0.8rem;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      margin-bottom: 1.25rem;
    }

    /* Field */
    .field { margin-bottom: 1rem; }
    .field label {
      display: block;
      color: #94a3b8;
      font-size: 0.78rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
      letter-spacing: 0.02em;
    }
    .field-wrap { position: relative; }
    .field-wrap i {
      position: absolute; left: 0.875rem;
      top: 50%; transform: translateY(-50%);
      color: #475569; font-size: 0.8rem;
      pointer-events: none;
    }
    .field-wrap input {
      width: 100%;
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(255,255,255,0.07);
      color: #f1f5f9;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      padding: 0.75rem 1rem 0.75rem 2.5rem;
      border-radius: 10px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .field-wrap input::placeholder { color: #334155; }
    .field-wrap input:focus {
      border-color: rgba(59,130,246,0.5);
      box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
    }

    /* Show password toggle */
    .field-wrap .toggle-pw {
      position: absolute; right: 0.875rem;
      top: 50%; transform: translateY(-50%);
      color: #475569; font-size: 0.8rem;
      background: none; border: none; cursor: pointer;
      padding: 0;
      transition: color 0.2s;
    }
    .field-wrap .toggle-pw:hover { color: #94a3b8; }

    /* Submit button */
    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, #1d4ed8, #2563eb);
      color: white;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 0.8rem;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 0.5rem;
      transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 14px rgba(37,99,235,0.4);
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    }
    .btn-submit:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37,99,235,0.45); }
    .btn-submit:active { transform: translateY(0); }

    .footer-note {
      text-align: center;
      color: #1e293b;
      font-size: 0.72rem;
      margin-top: 1.5rem;
    }
  </style>
</head>
<body>
  <div class="login-bg">
    <div class="glow-1"></div>
    <div class="glow-2"></div>
    <div class="grid-pattern"></div>

    <div class="card">
      <!-- Brand -->
      <div class="brand">
        <div class="brand-icon">
          <i class="fas fa-broom"></i>
        </div>
        <h1>Clean &amp; Shine</h1>
        <p>Admin Panel</p>
      </div>

      <!-- Form card -->
      <div class="form-card">
        <p class="form-title">Sign in to your account</p>

        {error && (
          <div class="error-box">
            <i class="fas fa-circle-exclamation"></i>
            {error === 'invalid' ? 'Incorrect username or password.' : 'An error occurred. Please try again.'}
          </div>
        )}

        <form method="POST" action="/api/auth/login">
          <input type="hidden" name="next" value={next} />

          <div class="field">
            <label for="user">Username</label>
            <div class="field-wrap">
              <i class="fas fa-user"></i>
              <input
                type="text"
                id="user"
                name="user"
                required
                autocomplete="username"
                placeholder="Enter your username"
              />
            </div>
          </div>

          <div class="field">
            <label for="pass">Password</label>
            <div class="field-wrap">
              <i class="fas fa-lock"></i>
              <input
                type="password"
                id="pass"
                name="pass"
                required
                autocomplete="current-password"
                placeholder="••••••••••"
              />
              <button type="button" class="toggle-pw" onclick="togglePw(this)" tabindex="-1">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-submit">
            <i class="fas fa-arrow-right-to-bracket"></i>
            Sign In
          </button>
        </form>
      </div>

      <p class="footer-note">Clean &amp; Shine Services &copy; {new Date().getFullYear()}</p>
    </div>
  </div>

  <script>
    function togglePw(btn) {
      const input = btn.closest('.field-wrap').querySelector('input');
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye-slash';
      } else {
        input.type = 'password';
        icon.className = 'fas fa-eye';
      }
    }
  </script>
</body>
</html>
